def socket_path() -> str:
    configured = os.environ.get("YDOTOOL_SOCKET")
    if configured:
        return configured
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    for candidate in ("/run/ydotool.sock", f"{runtime}/.ydotool_socket"):
        if os.path.exists(candidate):
            return candidate
    return "/run/ydotool.sock"


def ydotool(args: list[str], timeout: int = 15) -> None:
    exe = which("ydotool")
    if not exe:
        raise PcError("ydotool is not installed", "Run: sudo ./setup-uinput.sh")
    sock = socket_path()
    env = os.environ.copy()
    env["YDOTOOL_SOCKET"] = sock
    proc = run([exe, *args], timeout=timeout, env=env)
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()[:300]
        raise PcError(
            f"ydotool failed: {detail or 'unknown error'}",
            f"Is ydotoold running? socket={sock}. Run: pc-control doctor",
        )


def map_shot_point(x: float, y: float, native: bool = False) -> tuple[float, float]:
    """Map coordinates from the latest screenshot's pixel space to native pixels."""
    if native:
        return x, y
    meta = read_last_shot()
    if not meta:
        return x, y
    if not meta.get("mappable", True):
        raise PcError(
            "the latest screenshot is window-only and cannot be mapped to the screen",
            "Take a full shot (no --window) before moving or clicking, or pass --native.",
        )
    sx = float(meta.get("scale_x") or 1.0)
    sy = float(meta.get("scale_y") or 1.0)
    ox = float(meta.get("offset_x") or 0)
    oy = float(meta.get("offset_y") or 0)
    return ox + x * sx, oy + y * sy


def cmd_move(x: float, y: float, native: bool = False, scaled: bool = False,
             dry_run: bool = False) -> dict:
    nx, ny = map_shot_point(x, y, native)
    if scaled:
        info = display_info()
        nx, ny = nx / (info["scale"] or 1.0), ny / (info["scale"] or 1.0)
    tx, ty = round(nx), round(ny)
    base = {"screenshot_xy": [x, y], "target": [tx, ty]}
    if dry_run:
        return {"ok": True, "dry_run": True, **base}

    try:
        cx, cy = cursor_pos()
    except PcError:
        ydotool(["mousemove", "--absolute", "-x", str(tx), "-y", str(ty)])
        return {"ok": True, **base, "feedback": False, "note": "KWin unavailable; move is approximate"}

    attempts = 0
    gx = gy = 1.0
    for attempts in range(1, 26):
        dx, dy = tx - cx, ty - cy
        if abs(dx) <= 2 and abs(dy) <= 2:
            break
        # KWin applies adaptive acceleration: learn the gain and divide it out.
        sx = int(max(-220, min(220, dx / max(gx, 0.25) * 0.9)))
        sy = int(max(-220, min(220, dy / max(gy, 0.25) * 0.9)))
        if sx == 0 and dx != 0:
            sx = 1 if dx > 0 else -1
        if sy == 0 and dy != 0:
            sy = 1 if dy > 0 else -1
        px, py = cx, cy
        ydotool(["mousemove", "-x", str(sx), "-y", str(sy)])
        time.sleep(0.09)
        cx, cy = cursor_pos()
        if abs(sx) >= 20:
            gx = max(0.3, min(3.0, (cx - px) / sx))
        if abs(sy) >= 20:
            gy = max(0.3, min(3.0, (cy - py) / sy))
    result = {"ok": True, **base, "cursor": [cx, cy], "error": [cx - tx, cy - ty],
              "attempts": attempts}
    if abs(cx - tx) > 2 or abs(cy - ty) > 2:
        result["warning"] = "did not converge; verify with a fresh shot"
    return result


def cmd_cursor() -> dict:
    cx, cy = cursor_pos()
    meta = read_last_shot()
    if meta and meta.get("mappable", True):
        sx = float(meta.get("scale_x") or 1.0)
        sy = float(meta.get("scale_y") or 1.0)
        ox = float(meta.get("offset_x") or 0)
        oy = float(meta.get("offset_y") or 0)
        shot = [round((cx - ox) / sx), round((cy - oy) / sy)]
        return {"ok": True, "native": [cx, cy], "shot": shot,
                "scale": [sx, sy], "offset": [ox, oy]}
    return {"ok": True, "native": [cx, cy], "shot": [cx, cy]}


def cmd_move_rel(dx: float, dy: float, dry_run: bool = False) -> dict:
    args = ["mousemove", "-x", str(round(dx)), "-y", str(round(dy))]
    if dry_run:
        return {"ok": True, "dry_run": True, "ydotool": args}
    ydotool(args)
    return {"ok": True, "relative": [round(dx), round(dy)]}


def cmd_click(button: str, double: bool = False, at: list[float] | None = None,
              native: bool = False, dry_run: bool = False) -> dict:
    if button not in BUTTONS:
        raise PcError(f"unknown button {button!r}", "left, right, middle, side, extra")
    moved = None
    if at:
        moved = cmd_move(at[0], at[1], native=native, dry_run=dry_run)
        if not dry_run:
            time.sleep(0.05)
    args = ["click"]
    if double:
        args += ["--repeat", "2", "--next-delay", "80"]
    args.append(hex(BUTTONS[button][0]))
    if dry_run:
        return {"ok": True, "dry_run": True, "ydotool": args, "moved": moved}
    ydotool(args)
    return {"ok": True, "button": button, "double": double, "moved": moved}


def cmd_button(button: str, pressed: bool) -> dict:
    if button not in BUTTONS:
        raise PcError(f"unknown button {button!r}", "left, right, middle, side, extra")
    code = BUTTONS[button][1]
    ydotool(["key", f"{code}:{1 if pressed else 0}"])
    return {"ok": True, "button": button, "state": "down" if pressed else "up"}


def parse_keys(spec: str) -> list[int]:
    codes: list[int] = []
    for token in spec.split("+"):
        token = token.strip().lower()
        if not token:
            continue
        if token in KEYMAP:
            codes.append(KEYMAP[token])
        elif token.isdigit():
            codes.append(int(token))
        else:
            raise PcError(
                f"unknown key {token!r}",
                "Try letters, digits, space, enter, escape, tab, ctrl, shift, alt, f1..f12, arrows.",
            )
    if not codes:
        raise PcError("no keys given")
    return codes


def cmd_key(spec: str, hold_ms: int = 0, dry_run: bool = False) -> dict:
    codes = parse_keys(spec)
    events = [f"{code}:1" for code in codes]
    if hold_ms > 0:
        if dry_run:
            return {"ok": True, "dry_run": True, "press": events,
                    "hold_ms": hold_ms, "release": [f"{code}:0" for code in reversed(codes)]}
        ydotool(["key", *events])
        time.sleep(hold_ms / 1000.0)
        ydotool(["key", *[f"{code}:0" for code in reversed(codes)]])
        return {"ok": True, "keys": spec, "hold_ms": hold_ms}
    events += [f"{code}:0" for code in reversed(codes)]
    if dry_run:
        return {"ok": True, "dry_run": True, "key": events}
    ydotool(["key", *events])
    return {"ok": True, "keys": spec}


def cmd_type(text: str, dry_run: bool = False) -> dict:
    args = ["type", "--", text] if text.startswith("-") else ["type", text]
    if dry_run:
        return {"ok": True, "dry_run": True, "ydotool": args}
    ydotool(args, timeout=30)
    return {"ok": True, "typed": text}


def cmd_scroll(amount: int, horizontal: bool = False) -> dict:
    x, y = (amount, 0) if horizontal else (0, amount)
    ydotool(["mousemove", "--wheel", "-x", str(x), "-y", str(y)])
    return {"ok": True, "scroll": amount, "axis": "horizontal" if horizontal else "vertical"}



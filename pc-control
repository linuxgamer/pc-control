class PcError(Exception):
    def __init__(self, message: str, hint: str | None = None):
        super().__init__(message)
        self.hint = hint


def emit(obj: dict, code: int = 0) -> None:
    print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")))
    sys.exit(code)


def which(name: str) -> str | None:
    return shutil.which(name)


def run(cmd: list[str], timeout: int = 30, env: dict | None = None) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)
    except FileNotFoundError as exc:
        raise PcError(f"missing executable: {cmd[0]}") from exc
    except subprocess.TimeoutExpired as exc:
        raise PcError(f"timed out after {timeout}s: {cmd[0]}") from exc


# --------------------------------------------------------------------------- #
# state / paths
# --------------------------------------------------------------------------- #

_STATE: Path | None = None


def _writable(path: Path) -> bool:
    try:
        path.mkdir(parents=True, exist_ok=True)
        probe = path / f".probe-{os.getpid()}"
        probe.write_text("", encoding="utf-8")
        probe.unlink()
        return True
    except OSError:
        return False


def state_dir() -> Path:
    """Writable runtime directory: env override, cwd, runtime dir, then temp.

    The cwd default keeps screenshots and KWin helper scripts inside the agent
    workspace, where both the model and the host compositor can read them.
    """
    global _STATE
    if _STATE is not None:
        return _STATE
    candidates = []
    env = os.environ.get("PC_STATE_DIR")
    if env:
        candidates.append(Path(env).expanduser())
    candidates.append(Path.cwd() / ".pc-control")
    candidates.append(Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "pc-control")
    candidates.append(Path(tempfile.gettempdir()) / f"pc-control-{os.getuid()}")
    for candidate in candidates:
        if _writable(candidate):
            _STATE = candidate
            return candidate
    raise PcError("no writable state directory", "Set PC_STATE_DIR to a writable path.")


def shots_dir() -> Path:
    path = state_dir() / "shots"
    path.mkdir(parents=True, exist_ok=True)
    return path


def last_shot_path() -> Path:
    return state_dir() / "last-shot.json"


def read_last_shot() -> dict | None:
    try:
        return json.loads(last_shot_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def write_last_shot(meta: dict) -> None:
    try:
        last_shot_path().write_text(json.dumps(meta, ensure_ascii=False), encoding="utf-8")
    except OSError:
        pass


def prune_shots(keep: int = KEEP_SHOTS) -> None:
    try:
        files = sorted(shots_dir().glob("*"),
                       key=lambda p: p.stat().st_mtime, reverse=True)
        images = [p for p in files if p.suffix.lower() in (".png", ".jpg", ".jpeg")]
        for old in images[keep:]:
            old.unlink(missing_ok=True)
    except OSError:
        pass



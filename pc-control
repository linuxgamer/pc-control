def dispatch(action: dict) -> dict:
    name = action.get("action")
    if name == "shot":
        return screenshot(
            action.get("kind", "full"),
            action.get("out"),
            action.get("region"),
            action.get("max_width"),
            bool(action.get("full", False)),
            bool(action.get("grid", False)),
            bool(action.get("ocr", False)),
            action.get("ocr_lang"),
        )
    if name == "move":
        return cmd_move(float(action["x"]), float(action["y"]),
                        bool(action.get("native", False)), bool(action.get("scaled", False)))
    if name == "move-rel":
        return cmd_move_rel(float(action.get("dx", 0)), float(action.get("dy", 0)))
    if name == "click":
        return cmd_click(action.get("button", "left"), bool(action.get("double", False)),
                         action.get("at"), bool(action.get("native", False)))
    if name == "down":
        return cmd_button(action.get("button", "left"), True)
    if name == "up":
        return cmd_button(action.get("button", "left"), False)
    if name == "key":
        return cmd_key(action["keys"], int(action.get("hold_ms", 0)))
    if name == "type":
        return cmd_type(action["text"])
    if name == "scroll":
        return cmd_scroll(int(action.get("amount", 0)), bool(action.get("horizontal", False)))
    if name == "wait":
        time.sleep(max(0, int(action.get("ms", 0))) / 1000.0)
        return {"ok": True, "waited_ms": int(action.get("ms", 0))}
    if name == "cursor":
        return cmd_cursor()
    if name == "screen":
        info = display_info()
        meta = read_last_shot()
        return {"ok": True, **info, "last_shot": meta}
    if name == "active":
        return cmd_active()
    if name == "focus":
        return cmd_focus(action["pattern"])
    raise PcError(f"unknown action {name!r}")


def cmd_run(spec: str, continue_on_error: bool = False) -> dict:
    raw = sys.stdin.read() if spec == "-" else spec
    try:
        actions = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise PcError(f"invalid JSON: {exc}") from exc
    if not isinstance(actions, list):
        raise PcError("run expects a JSON array of actions")
    if len(actions) > 60:
        raise PcError("too many actions in one run (max 60)")
    results = []
    for index, action in enumerate(actions):
        if not isinstance(action, dict):
            raise PcError(f"action {index} is not an object")
        try:
            results.append(dispatch(action))
        except PcError as exc:
            results.append({"ok": False, "action": action.get("action"), "index": index,
                            "error": str(exc), "hint": exc.hint})
            if not continue_on_error:
                return {"ok": False, "index": index, "results": results}
    return {"ok": all(r.get("ok") for r in results), "results": results}


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="pc-control", description=__doc__.splitlines()[0])
    parser.add_argument("--version", action="version", version=f"pc-control {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("doctor")
    sub.add_parser("screen")

    p = sub.add_parser("shot")
    p.add_argument("--window", action="store_true")
    p.add_argument("--screen", action="store_true")
    p.add_argument("--out")
    p.add_argument("--region", nargs=4, type=int, metavar=("X", "Y", "W", "H"))
    p.add_argument("--max-width", type=int, default=None)
    p.add_argument("--full", action="store_true")
    p.add_argument("--grid", action="store_true")
    p.add_argument("--ocr", action="store_true")
    p.add_argument("--ocr-lang", default=None)

    p = sub.add_parser("move")
    p.add_argument("x", type=float)
    p.add_argument("y", type=float)
    p.add_argument("--native", action="store_true")
    p.add_argument("--scaled", action="store_true")
    p.add_argument("--dry-run", action="store_true")

    p = sub.add_parser("move-rel")
    p.add_argument("dx", type=float)
    p.add_argument("dy", type=float)
    p.add_argument("--dry-run", action="store_true")

    p = sub.add_parser("click")
    p.add_argument("button", nargs="?", default="left")
    p.add_argument("--double", action="store_true")
    p.add_argument("--at", nargs=2, type=float, metavar=("X", "Y"))
    p.add_argument("--native", action="store_true")
    p.add_argument("--dry-run", action="store_true")

    p = sub.add_parser("down")
    p.add_argument("button", nargs="?", default="left")
    p = sub.add_parser("up")
    p.add_argument("button", nargs="?", default="left")

    p = sub.add_parser("key")
    p.add_argument("keys")
    p.add_argument("--hold", type=int, default=0, metavar="MS")
    p.add_argument("--dry-run", action="store_true")

    p = sub.add_parser("type")
    p.add_argument("text")

    p = sub.add_parser("scroll")
    p.add_argument("amount", type=int)
    p.add_argument("--horizontal", action="store_true")

    p = sub.add_parser("wait")
    p.add_argument("ms", type=int)

    p = sub.add_parser("run")
    p.add_argument("spec")
    p.add_argument("--continue-on-error", action="store_true")


    sub.add_parser("active")
    sub.add_parser("cursor")
    p = sub.add_parser("focus")
    p.add_argument("pattern")
    return parser


def main(argv: list[str]) -> None:
    args = build_parser().parse_args(argv)
    try:
        if args.command == "doctor":
            emit(cmd_doctor())
        if args.command == "screen":
            emit({"ok": True, **display_info(), "last_shot": read_last_shot()})
        if args.command == "shot":
            kind = "window" if args.window else "screen" if args.screen else "full"
            emit(screenshot(kind, args.out, args.region, args.max_width, args.full,
                            args.grid, args.ocr, args.ocr_lang))
        if args.command == "move":
            emit(cmd_move(args.x, args.y, args.native, args.scaled, args.dry_run))
        if args.command == "move-rel":
            emit(cmd_move_rel(args.dx, args.dy, args.dry_run))
        if args.command == "click":
            emit(cmd_click(args.button, args.double, args.at, args.native, args.dry_run))
        if args.command == "down":
            emit(cmd_button(args.button, True))
        if args.command == "up":
            emit(cmd_button(args.button, False))
        if args.command == "key":
            emit(cmd_key(args.keys, args.hold, args.dry_run))
        if args.command == "type":
            emit(cmd_type(args.text))
        if args.command == "scroll":
            emit(cmd_scroll(args.amount, args.horizontal))
        if args.command == "wait":
            time.sleep(max(0, args.ms) / 1000.0)
            emit({"ok": True, "waited_ms": args.ms})
        if args.command == "run":
            emit(cmd_run(args.spec, args.continue_on_error))
        if args.command == "active":
            emit(cmd_active())
        if args.command == "cursor":
            emit(cmd_cursor())
        if args.command == "focus":
            emit(cmd_focus(args.pattern))
        raise PcError(f"unknown command {args.command!r}")
    except PcError as exc:
        emit({"ok": False, "command": args.command, "error": str(exc), "hint": exc.hint}, 1)
    except KeyboardInterrupt:
        emit({"ok": False, "error": "interrupted"}, 130)


if __name__ == "__main__":
    main(sys.argv[1:])

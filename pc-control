def cmd_doctor() -> dict:
    checks = []

    def add(name: str, ok: bool, detail: str, required: bool = True) -> None:
        checks.append({"name": name, "ok": ok, "detail": detail, "required": required})

    add("session", os.environ.get("XDG_SESSION_TYPE") in ("wayland", "x11"),
        f"type={os.environ.get('XDG_SESSION_TYPE')} wayland={os.environ.get('WAYLAND_DISPLAY')}",
        required=False)
    info = display_info()
    add("display", bool(info["physical"]),
        f"{info['output']} {info['physical']} logical={info['logical']} display_scale={info['scale']}")
    try:
        backend = detect_backend()
        add("screenshot", True, backend)
    except PcError as exc:
        add("screenshot", False, str(exc))
    add("ydotool", bool(which("ydotool")), which("ydotool") or "not found")
    sock = socket_path()
    add("ydotoold", os.path.exists(sock), sock)
    add("uinput", os.path.exists("/sys/class/misc/uinput"),
        "loaded" if os.path.exists("/sys/class/misc/uinput") else "uinput module not loaded")
    add("kwin", kwin_available(), "qdbus6 + journalctl (cursor/focus feedback)", required=False)
    add("pillow", _has_pillow(), "compact/grid/region shots")
    langs = ocr_languages()
    add("tesseract", bool(which("tesseract")),
        f"languages: {', '.join(langs) if langs else 'none'}", required=False)
    add("state", _writable(state_dir()), str(state_dir()))
    add("sandbox", True,
        "expected under an agent sandbox: /dev/uinput hidden; ydotool uses the host daemon",
        required=False)
    ready = all(c["ok"] for c in checks if c["required"])
    return {"ok": True, "ready": ready, "checks": checks}


def _has_pillow() -> bool:
    try:
        import PIL  # noqa: F401
        return True
    except ImportError:
        return False



def display_info() -> dict:
    """Physical and logical geometry plus the display scale."""
    try:
        out = run(["kscreen-doctor", "-j"], timeout=10).stdout
        data = json.loads(out)
        for output in data.get("outputs", []):
            if not output.get("enabled"):
                continue
            scale = float(output.get("scale") or 1.0) or 1.0
            mode = next(
                (m for m in output.get("modes", []) if m.get("id") == output.get("currentModeId")),
                None,
            )
            if mode:
                pw, ph = mode["size"]["width"], mode["size"]["height"]
                return {
                    "output": output.get("name"),
                    "scale": scale,
                    "physical": [pw, ph],
                    "logical": [round(pw / scale), round(ph / scale)],
                }
    except (PcError, ValueError, KeyError, TypeError):
        pass
    try:
        out = run(["xrandr", "--current"], timeout=10).stdout
        match = re.search(r"current\s+(\d+)\s*x\s*(\d+)", out)
        if match:
            pw, ph = int(match.group(1)), int(match.group(2))
            return {"output": None, "scale": 1.0, "physical": [pw, ph], "logical": [pw, ph]}
    except PcError:
        pass
    return {"output": None, "scale": 1.0, "physical": None, "logical": None}


def image_size(path: Path) -> tuple[int, int]:
    try:
        from PIL import Image
        with Image.open(path) as image:
            return image.size
    except ImportError:
        pass
    with path.open("rb") as handle:
        head = handle.read(33)
    if head[:8] != b"\x89PNG\r\n\x1a\n":
        raise PcError(f"cannot read image size: {path}")
    return struct.unpack(">II", head[16:24])


def detect_backend() -> str:
    forced = os.environ.get("PC_SCREENSHOT_BACKEND")
    if forced:
        if not which(forced):
            raise PcError(f"PC_SCREENSHOT_BACKEND={forced!r} not found")
        return forced
    for name in SCREENSHOT_BACKENDS:
        if which(name):
            return name
    raise PcError(
        "no screenshot backend found",
        "Install spectacle (KDE), grim (wlroots), gnome-screenshot, wayshot, or scrot.",
    )


def capture(kind: str, path: Path) -> tuple[str, str | None]:
    """Capture a raw PNG. Returns (effective kind, warning)."""
    backend = detect_backend()
    warning = None
    env = os.environ.copy()
    if backend == "spectacle":
        env["XDG_CONFIG_HOME"] = str(state_dir() / "config")
        env["XDG_CACHE_HOME"] = str(state_dir() / "cache")
        (state_dir() / "config").mkdir(parents=True, exist_ok=True)
        (state_dir() / "cache").mkdir(parents=True, exist_ok=True)
        flag = {"full": "-f", "window": "-a", "screen": "-m"}[kind]
        args = [which("spectacle"), flag, "-b", "-n", "-o", str(path)]
    elif backend == "grim":
        if kind != "full":
            warning = "grim supports full-screen capture only; captured full screen"
            kind = "full"
        args = [which("grim"), str(path)]
    elif backend == "gnome-screenshot":
        if kind != "full":
            warning = "gnome-screenshot supports full-screen capture only; captured full screen"
            kind = "full"
        args = [which("gnome-screenshot"), "-f", str(path)]
    elif backend == "wayshot":
        if kind != "full":
            warning = "wayshot supports full-screen capture only; captured full screen"
            kind = "full"
        args = [which("wayshot"), "-f", str(path)]
    elif backend == "scrot":
        if kind != "full":
            warning = "scrot supports full-screen capture only; captured full screen"
            kind = "full"
        args = [which("scrot"), str(path)]
    else:  # ImageMagick import (X11)
        if kind != "full":
            warning = "import supports full-screen capture only; captured full screen"
            kind = "full"
        args = [which("import"), "-window", "root", str(path)]
    proc = run(args, timeout=30, env=env)
    if proc.returncode != 0 or not path.exists():
        raise PcError(f"{backend} failed: {(proc.stderr or proc.stdout).strip()[:300]}")
    return kind, warning


def require_pillow():
    try:
        from PIL import Image, ImageDraw  # noqa: F401
        return Image, ImageDraw
    except ImportError as exc:
        raise PcError(
            "Pillow is required for compact/grid/region shots",
            "Install it: python3 -m pip install --user pillow (or use --full --no-grid).",
        ) from exc


def ocr_text(path: Path, lang: str) -> str:
    exe = which("tesseract")
    if not exe:
        raise PcError("tesseract is not installed", "Install tesseract-ocr to use --ocr.")
    proc = run([exe, str(path), "stdout", "-l", lang], timeout=30)
    if proc.returncode != 0:
        raise PcError(f"tesseract failed: {(proc.stderr or proc.stdout).strip()[:200]}")
    return proc.stdout.strip()


def ocr_languages() -> list[str]:
    exe = which("tesseract")
    if not exe:
        return []
    proc = run([exe, "--list-langs"], timeout=10)
    lines = [line.strip() for line in proc.stdout.splitlines()]
    return [line for line in lines if line and " " not in line]


def pick_ocr_lang(requested: str | None) -> str:
    available = ocr_languages()
    if requested:
        if requested not in available:
            raise PcError(
                f"OCR language {requested!r} is not installed",
                f"Available: {', '.join(available) or 'none'} (install tesseract-data-<lang>).",
            )
        return requested
    env = os.environ.get("PC_OCR_LANG")
    if env and env in available:
        return env
    preferred = (os.environ.get("LANG") or "").split(".")[0].split("_")[0].lower()
    for candidate in (preferred, "eng"):
        if candidate and candidate in available:
            return candidate
    if available:
        return available[0]
    raise PcError("no tesseract language data installed",
                  "Install tesseract-data-eng (or your language).")


def add_grid(image, draw, step: int = 100) -> None:
    for x in range(step, image.width, step):
        draw.line([(x, 0), (x, image.height)], fill=(255, 0, 0), width=1)
    for y in range(step, image.height, step):
        draw.line([(0, y), (image.width, y)], fill=(255, 0, 0), width=1)
    for x in range(200, image.width, 200):
        draw.text((x + 3, 2), str(x), fill=(255, 255, 0))
    for y in range(200, image.height, 200):
        draw.text((3, y + 1), str(y), fill=(255, 255, 0))


def screenshot(kind: str = "full", out: str | None = None, region: list[int] | None = None,
               max_width: int | None = None, full: bool = False, grid: bool = False,
               ocr: bool = False, lang: str | None = None) -> dict:
    state = state_dir()
    shots_dir()
    raw = shots_dir() / f".raw-{int(time.time())}-{random.randrange(0xFFFF):04x}.png"
    effective_kind, warning = capture(kind, raw)
    work = raw
    try:
        native_w, native_h = image_size(raw)
        offset_x = offset_y = 0
        work = raw
        work_w, work_h = native_w, native_h
        if region:
            if len(region) != 4:
                raise PcError("--region needs X Y W H")
            rx, ry, rw, rh = region
            if rw <= 0 or rh <= 0 or rx < 0 or ry < 0 or rx + rw > native_w or ry + rh > native_h:
                raise PcError(f"region {region} is outside the {native_w}x{native_h} screen")
            Image, _ = require_pillow()
            with Image.open(raw) as image:
                work = raw.with_name(raw.stem + "-crop.png")
                image.crop((rx, ry, rx + rw, ry + rh)).save(work)
            offset_x, offset_y = rx, ry
            work_w, work_h = rw, rh

        text = None
        ocr_error = None
        if ocr:
            try:
                text = ocr_text(work, pick_ocr_lang(lang))
            except PcError as exc:
                ocr_error = str(exc)
                if exc.hint:
                    ocr_error = f"{ocr_error} — {exc.hint}"

        target_w = work_w if full else min(work_w, max_width or DEFAULT_MAX_WIDTH)
        scale = work_w / target_w
        target_h = round(work_h / scale)
        suffix = ".png" if full and not grid else ".jpg"
        if out:
            dest = Path(out).expanduser().resolve()
            dest.parent.mkdir(parents=True, exist_ok=True)
        else:
            dest = shots_dir() / f"{time.strftime('%Y%m%d-%H%M%S')}-{random.randrange(0xFFFF):04x}{suffix}"

        if scale == 1 and not grid and dest.suffix.lower() == ".png":
            shutil.copyfile(work, dest)
        else:
            Image, ImageDraw = require_pillow()
            with Image.open(work) as image:
                image = image.convert("RGB")
                if scale != 1:
                    image = image.resize((target_w, target_h), Image.LANCZOS)
                if grid:
                    add_grid(image, ImageDraw.Draw(image))
                if dest.suffix.lower() in (".jpg", ".jpeg"):
                    image.save(dest, "JPEG", quality=JPEG_QUALITY, optimize=True)
                else:
                    image.save(dest, "PNG")

        width, height = image_size(dest)
        meta = {
            "ok": True,
            "path": str(dest),
            "width": width,
            "height": height,
            "native_width": work_w,
            "native_height": work_h,
            "scale_x": work_w / width,
            "scale_y": work_h / height,
            "offset_x": offset_x,
            "offset_y": offset_y,
            "kind": effective_kind,
            "mappable": effective_kind != "window",
            "format": dest.suffix.lower().lstrip("."),
            "bytes": dest.stat().st_size,
            "note": "coordinates are pixels in this image; move() maps them to native automatically",
        }
        if effective_kind == "window":
            meta["clickable"] = False
            meta["hint"] = "window shots are for reading; take a full shot before moving/clicking"
        if warning:
            meta["warning"] = warning
        if text is not None:
            meta["ocr"] = text
        if ocr_error is not None:
            meta["ocr_error"] = ocr_error
        write_last_shot(meta)
        prune_shots()
        return meta
    finally:
        for leftover in {raw, work}:
            leftover.unlink(missing_ok=True)


# --------------------------------------------------------------------------- #
# KWin scripting: cursor position, active window, focus
# --------------------------------------------------------------------------- #

def kwin_available() -> bool:
    return bool(which("qdbus6") and which("journalctl"))


def kwin_call(method: str, *args: str) -> str:
    cmd = ["qdbus6", "org.kde.KWin", "/Scripting", f"org.kde.kwin.Scripting.{method}", *args]
    proc = run(cmd, timeout=5)
    if proc.returncode != 0:
        raise PcError(f"KWin scripting failed: {(proc.stderr or proc.stdout).strip()[:200]}")
    return proc.stdout


def kwin_script(body: str, marker: str, timeout: float = 2.0) -> str:
    if not kwin_available():
        raise PcError("KWin scripting not available", "This feature needs KDE Plasma with qdbus6.")
    nonce = f"{os.getpid()}-{time.time_ns()}"
    name = f"pc-{marker.lower()}-{nonce}"
    folder = state_dir() / "kwin"
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"{name}.js"
    path.write_text(body.replace("__MARKER__", marker).replace("__NONCE__", nonce), encoding="utf-8")
    try:
        kwin_call("loadScript", str(path), name)
        kwin_call("start")
        needle = f"{marker}:{nonce}:"
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            out = run(["journalctl", "--user", "-o", "cat", "-n", "400", "--no-pager"],
                      timeout=5).stdout
            for line in out.splitlines():
                if needle in line:
                    return line.split(needle, 1)[1].strip()
            time.sleep(0.05)
        raise PcError("KWin did not answer the script")
    finally:
        try:
            kwin_call("unloadScript", name)
        except PcError:
            pass
        path.unlink(missing_ok=True)


def cursor_pos() -> tuple[int, int]:
    value = kwin_script(
        'print("__MARKER__:__NONCE__:" + workspace.cursorPos.x + "," + workspace.cursorPos.y);',
        "PCCURSOR",
    )
    pair = value.split(",")
    if len(pair) < 2:
        raise PcError(f"unexpected cursor reply: {value!r}")
    return int(pair[0]), int(pair[1])


def cmd_active() -> dict:
    value = kwin_script(
        'var w = workspace.activeWindow; print("__MARKER__:__NONCE__:" + (w ? (w.caption + " | " + (w.resourceClass || "")) : "none"));',
        "PCACTIVE",
    )
    return {"ok": True, "active": value}


def cmd_focus(pattern: str) -> dict:
    body = (
        'var pat = ' + json.dumps(pattern.lower()) + ';\n'
        'var list = (typeof workspace.windowList === "function") ? workspace.windowList() : workspace.clientList();\n'
        'var hit = null;\n'
        'for (var i = 0; i < list.length; i++) {\n'
        '  var w = list[i];\n'
        '  var cls = ((w.resourceClass || "") + "").toLowerCase();\n'
        '  var cap = ((w.caption || "") + "").toLowerCase();\n'
        '  if (cls.indexOf(pat) >= 0 || cap.indexOf(pat) >= 0) { hit = w; break; }\n'
        '}\n'
        'if (hit) { hit.minimized = false; workspace.activeWindow = hit; }\n'
        'print("__MARKER__:__NONCE__:" + (hit ? hit.caption : "NOTFOUND"));'
    )
    value = kwin_script(body, "PCFOCUS")
    if value == "NOTFOUND":
        raise PcError(f"no window matching {pattern!r}", "Try part of the window title or class.")
    return {"ok": True, "focused": value}


